ENVIRONMENT=dev
LOG_LEVEL=INFO
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://fpm:change-me@postgres:5432/fpm
RABBITMQ_URL=amqp://fpm:change-me@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
JAEGER_ENDPOINT=http://jaeger:4317
PROMETHEUS_PORT=9090
JWT_ALGORITHM=RS256
JWT_AUDIENCE=fpm-api
JWT_ISSUER=fpm-auth
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_PUBLIC_KEYS={}
JWT_ACTIVE_KID=local-dev
AUTH_SERVICE_URL=http://auth:8000
ACCOUNTS_SERVICE_URL=http://accounts:8000
PAYMENTS_SERVICE_URL=http://payments:8000
LEDGER_SERVICE_URL=http://ledger:8000
ANTIFRAUD_SERVICE_URL=http://antifraud:8000
NOTIFICATION_SERVICE_URL=http://notification:8000
CASHBACK_SERVICE_URL=http://cashback:8000
EXTERNAL_SERVICE_URL=http://external:8000
TELEGRAM_STUB_URL=http://telegram-stub:8000
EVERYPAY_BASE_URL=http://everypay-stub:8000
EVERYPAY_API_KEY=change-me
